# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Required in production. Used for Host/Origin validation.
PUBLIC_BASE_URL=https://mcp.example.com
# Optional comma-separated additions, without schemes or ports.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Internal TAAFT API
TAAFT_API_BASE_URL=https://api.example.com
TAAFT_API_KEY=
TAAFT_API_KEY_HEADER=Authorization
# Defaults to "Bearer ". Set this only when the upstream uses another prefix.
# TAAFT_API_KEY_PREFIX=
TAAFT_SEARCH_PATH=/v1/tools/search
TAAFT_TOOL_PATH_TEMPLATE=/v1/tools/{slug}
TAAFT_API_TIMEOUT_MS=10000
TAAFT_MAX_RESPONSE_BYTES=2000000
